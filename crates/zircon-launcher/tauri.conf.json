{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zircon",
  "version": "0.1.0",
  "identifier": "com.zircon.launcher",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zircon Launcher",
        "width": 1160,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.mcmanager/**", "$HOME/.zircon/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Zircon Minecraft launcher & server companion",
    "longDescription": "Zircon (MCManager) launcher: Microsoft authentication, mod/pack sync, offline instances and 3D skin previews.",
    "category": "Game",
    "copyright": "Copyright (c) Zircon contributors"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://zirconmc.net/updates/launcher/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QjFBMEU3QzM0MDY4REEKUldUYWFFREQ1NkN4WnZUUkJ4bFowUlBLaXc0Q0V5eExDY2x0dGd1MllPeVFWelFmTE1WeVpqYkEK"
    }
  }
}
